<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="settingsScrim">#1AFFFFFF</item>
        <item name="settingsNavRest">#00000000</item>
        <item name="settingsRowRest">#1A000000</item>
        <item name="settingsNavSelected">#24000000</item>
        <item name="settingsSectionText">#B3000000</item>
        <item name="settingsTitleText">#BF000000</item>
        <item name="settingsNavText">#BF000000</item>
        <item name="settingsHintText">#A6000000</item>
    </style>
    <!-- The dark colour scheme: black screen, white-washed inactive rows. Applied over the theme by LauncherSettingsActivity. -->
    <!-- Monochrome backdrop: the inactive rows' backing is darker. Applied over the theme (and over SettingsDark). -->
    <style name="SettingsMonoLight">
        <item name="settingsRowRest">#73000000</item>
        <item name="settingsNavRest">#00000000</item>
        <item name="settingsNavSelected">#73000000</item>
    </style>
    <style name="SettingsMonoDark">
        <item name="settingsRowRest">#33FFFFFF</item>
        <item name="settingsNavRest">#00000000</item>
    </style>
    <style name="SettingsDark">
        <item name="settingsScrim">#1A000000</item>
        <item name="settingsRowRest">#33FFFFFF</item>
        <item name="settingsNavSelected">#33FFFFFF</item>
        <item name="settingsSectionText">#99FFFFFF</item>
        <item name="settingsTitleText">#FFFFFFFF</item>
        <item name="settingsNavText">#FFFFFFFF</item>
        <item name="settingsHintText">#80FFFFFF</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />

    <!-- Icon-only pill: a 42dp circle (pill_bg's 21dp corners) with the 22dp icon centred by even padding. Give it a
         contentDescription, since there is no text. -->
    <style name="TopButtonIcon" parent="TopButtonBase">
        <item name="android:layout_width">42dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>

    <style name="SettingsRow">
        <item name="android:stateListAnimator">@animator/settings_focus_scale</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:background">@drawable/settings_choice_bg</item>
        <item name="android:textColor">@drawable/settings_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <!-- A line of the About page that only shows a value: no wash, not focusable. -->
    <style name="SettingsInfoRow" parent="SettingsRow">
        <item name="android:background">@null</item>
        <item name="android:focusable">false</item>
        <item name="android:clickable">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="SettingsColumnChoice" parent="SettingsRow">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="SettingsBackRow">
        <item name="android:stateListAnimator">@animator/settings_focus_scale</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:background">@drawable/settings_choice_bg</item>
        <item name="android:textColor">@drawable/settings_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:drawableStart">@drawable/ic_settings_back</item>
        <item name="android:drawableTint">@drawable/settings_text</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="SettingsOptionRow">
        <item name="android:stateListAnimator">@animator/settings_focus_scale</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:background">@drawable/settings_choice_bg_plain</item>
        <item name="android:textColor">@drawable/settings_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:drawableTint">@drawable/settings_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="SettingsNavItem">
        <item name="android:stateListAnimator">@animator/settings_focus_scale</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/settings_nav_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="SettingsNavChip">
        <item name="android:layout_width">27dp</item>
        <item name="android:layout_height">27dp</item>
        <item name="android:padding">5dp</item>
        <item name="android:background">@drawable/settings_nav_chip</item>
    </style>
    <style name="SettingsNavLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textColor">@drawable/settings_nav_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="SettingsSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:paddingStart">4.5dp</item>
        <item name="android:textColor">?attr/settingsSectionText</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:fontFamily">@string/font_medium</item>
    </style>
    <style name="SettingsCardLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#EBF4F4F6</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@string/font_medium</item>
    </style>
    <style name="SettingsHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:textColor">?attr/settingsHintText</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@string/font_regular</item>
    </style>
    <style name="SettingsDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/settings_dialog_bg</item>
    </style>
</resources>
