<?xml version="1.0" encoding="utf-8"?>
<!-- Local patch: pill_bg_glass, transparent at rest — the liquid shader's own blur/refraction (WallpaperPlayer's
     buttonsBlurImage) is the whole look, not a white wash on top of it too. Solid white only when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
