<?xml version="1.0" encoding="utf-8"?>
<!-- Local patch: pill_bg without its own resting-state gradient/stroke, for when a glass/liquid dock layer
     already sits behind the whole top-bar row (MainActivity, wallpaperPlayer.hasDockBlur()) — that backdrop is
     enough on its own, so the pill itself only needs to show focus (and reorder-mode) feedback. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
