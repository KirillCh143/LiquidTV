<?xml version="1.0" encoding="utf-8"?>
<!-- Local patch: a grid tile's background in popup_settings_grid — transparent at rest, so each tile's own
     glass layer (MainActivity.addTileGlass) is all that shows, not a white wash on top of it too. Solid white
     only when focused, the same feedback every other pill in the launcher gives. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="42px" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="42px" />
        </shape>
    </item>
</selector>
