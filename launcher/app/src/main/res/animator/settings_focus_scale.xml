<?xml version="1.0" encoding="utf-8"?>
<!-- A focused settings entry grows 2%. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.02" android:valueType="floatType" android:duration="140" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.02" android:valueType="floatType" android:duration="140" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" android:duration="140" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" android:duration="140" />
        </set>
    </item>
</selector>
